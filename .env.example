# Use a dedicated transportation database; never point this at another project.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/university_transport"

# Generate a unique random value with at least 32 bytes of entropy.
AUTH_SECRET="replace-with-a-long-random-secret-before-running"

# Used only by the explicit local seed command. Choose your own values.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Transport Admin"

# Optional for local development; proofs use the ignored ./storage/proofs directory when unset.
# Required in production. Create a private Supabase Storage bucket named payment-proofs.
# SUPABASE_URL="https://PROJECT.supabase.co"
# SUPABASE_SECRET_KEY="your-server-only-secret-key"
